{
  "name": "media-monitor-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "format": "prettier --write src index.html package.json tsconfig.json tsconfig.node.json vite.config.ts",
    "format:check": "prettier --check src index.html package.json tsconfig.json tsconfig.node.json vite.config.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2"
  }
}
